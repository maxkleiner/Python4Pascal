  object CodeMem: TMemo
    Left = 0
    Height = 202
    Top = 35
    Width = 624
    Align = alClient
    Lines.Strings = (
      'import mytest'
      ''
      'print("Saving the sample string in the Delphi form...")'
      'mytest.write("sample")'
      ''
      'print("Reading the previously saved value from the Delphi form...")'
      'print(mytest.read())'
    )
    TabOrder = 2
  end
end
